@model Libro

<tr>
    <td>@Model.Titulo</td>
    <td>@Model.ISBN</td>
    <td>@Model.AutorNombre</td>
    <td class="text-center">@Model.Ejemplares</td>
    <td class="text-end">
        <a asp-action="Details" asp-route-id="@Model.LibroId" class="btn btn-sm btn-outline-info">Ver</a>
        <a asp-action="Edit" asp-route-id="@Model.LibroId" class="btn btn-sm btn-outline-warning">Editar</a>
        <a asp-action="Delete" asp-route-id="@Model.LibroId" class="btn btn-sm btn-outline-danger">Eliminar</a>
    </td>
</tr>