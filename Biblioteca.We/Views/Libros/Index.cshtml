@model IEnumerable<Libro>
@{
    ViewData["Title"] = "Libros";
    var busqueda = ViewData["Busqueda"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>📚 Libros</h1>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo libro</a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input type="text" name="titulo" value="@busqueda" class="form-control" placeholder="Buscar por título..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(busqueda))
    {
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    }
</form>

@if (!string.IsNullOrWhiteSpace(busqueda))
{
    <p class="text-muted">Resultados para "<strong>@busqueda</strong>": @Model.Count() libro(s) encontrado(s).</p>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No se encontraron libros.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Título</th>
                <th>ISBN</th>
                <th>Autor</th>
                <th class="text-center">Ejemplares</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var libro in Model)
            {
                <partial name="_FilaLibro" model="libro" />
            }
        </tbody>
    </table>
}