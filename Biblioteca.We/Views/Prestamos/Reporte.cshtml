@model IEnumerable<PrestamoReporte>
@{
    ViewData["Title"] = "Reporte de préstamos";
}

<h1>📋 Reporte de préstamos</h1>
<hr />

<form asp-action="Reporte" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label for="desde" class="form-label">Desde</label>
        <input type="date" id="desde" name="desde" value="@ViewData["Desde"]" class="form-control" required />
    </div>
    <div class="col-auto">
        <label for="hasta" class="form-label">Hasta</label>
        <input type="date" id="hasta" name="hasta" value="@ViewData["Hasta"]" class="form-control" required />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filtrar</button>
    </div>
</form>

@if (ViewData["Error"] != null)
{
    <div class="alert alert-danger">@ViewData["Error"]</div>
}

<p class="text-muted">
    Mostrando préstamos del <strong>@ViewData["Desde"]</strong> al <strong>@ViewData["Hasta"]</strong>:
    @Model.Count() préstamo(s).
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay préstamos en el rango seleccionado.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>N°</th>
                <th>Socio</th>
                <th>DNI</th>
                <th>Libros</th>
                <th>Fecha préstamo</th>
                <th>Fecha límite</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                var color = p.Estado switch
                {
                    "Devuelto" => "bg-success",
                    "Vencido" or "Atrasado" => "bg-danger",
                    _ => "bg-warning text-dark"
                };
                <tr>
                    <td>@p.PrestamoId</td>
                    <td>@p.Socio</td>
                    <td>@p.DNI</td>
                    <td>@p.Libros</td>
                    <td>@p.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                    <td>@p.FechaLimite.ToString("dd/MM/yyyy")</td>
                    <td><span class="badge @color">@p.Estado</span></td>
                </tr>
            }
        </tbody>
    </table>
}